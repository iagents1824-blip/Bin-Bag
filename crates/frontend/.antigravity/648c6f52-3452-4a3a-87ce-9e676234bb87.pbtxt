          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    content: \'We just open-sourced our RAG orchestration for clinical PubMed paper indexing. We are looking for peer feedback on vector chunking strategies (512 token overlap vs semantic sentence splits). Check out the pipeline snippet below.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    codeSnippet: `from llama_index.core.node_parser import SemanticSplitterNodeParser"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "from llama_index.embeddings.gemini import GeminiEmbedding"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "embed_model = GeminiEmbedding(model_name=\"models/text-embedding-004\")"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "splitter = SemanticSplitterNodeParser("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    buffer_size=1, breakpoint_percentile_threshold=95, embed_model=embed_model"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: ")`,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
