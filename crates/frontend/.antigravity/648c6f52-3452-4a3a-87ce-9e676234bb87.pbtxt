        lines {
          text: "    type: \'Support Request\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    content: \'Default Ollama Modelfiles cap `num_ctx` at 2048 tokens unless explicitly overriden in your request payload or custom Modelfile. Here is how to lock `num_ctx` to 32768 tokens permanently.\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    codeSnippet: `FROM llama3.3:70b"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "PARAMETER num_ctx 32768"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "PARAMETER num_predict 4096"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "PARAMETER temperature 0.2`,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
