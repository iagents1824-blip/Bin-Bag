        lines {
          text: "    title: \'Reducing quantization loss on Llama-3.3-70B for 4-bit EXL2 & GGUF\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    author: {"
