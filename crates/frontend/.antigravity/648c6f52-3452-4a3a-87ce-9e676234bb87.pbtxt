          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    title: \'Reducing quantization loss on Llama-3.3-70B for 4-bit EXL2 & GGUF\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    author: {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      name: \'Elena Rostova\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      handle: \'quant_master\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      avatar: \'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      role: \'Core Quantizer\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    type: \'Enhancement Tip\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    content: \'When quantizing 70B models down to 4.25 bits, standard Importance Matrix (imatrix) datasets trained on Wikipedia cause notable perplexity degradation in mathematical reasoning. By replacing the calibration dataset with 10k synthetic Python & LaTeX proofs, we reduced perplexity from 6.42 down to 4.88!\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    codeSnippet: `# Quantize command with custom calibration dataset"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "llama-quantize --imatrix calibration_math_proofs.dat \\\\"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  ./llama-3.3-70b-fp16.gguf \\\\"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  ./llama-3.3-70b-Q4_K_M.gguf \\\\"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  Q4_K_M`,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    tags: [\'Llama-3.3\', \'Quantization\', \'GGUF\', \'Optimization\'],"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
